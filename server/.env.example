# Contoh konfigurasi Naze Vector Render Server.
# Salin ke .env atau set sebagai variabel lingkungan di panel (mis. Pterodactyl).

# Port HTTP server (1..65535)
NAZE_PORT=3000

# Direktori penyimpanan job (meta + video sementara)
NAZE_JOBS_DIR=./jobs

# Host yang diizinkan untuk asset sourceUrl, dipisah koma.
# Wildcard mencakup semua tingkat subdomain: *.example.org
NAZE_SOURCE_ALLOWLIST=

# Umur video hasil render sebelum dihapus otomatis (milidetik, > 0)
NAZE_VIDEO_TTL_MS=3600000

# Ruang disk bebas minimal sebelum menerima job baru (byte, > 0)
NAZE_MIN_FREE_DISK_BYTES=536870912

# Path binary FFmpeg/FFprobe bila tidak berada di PATH
NAZE_FFMPEG_PATH=ffmpeg
NAZE_FFPROBE_PATH=ffprobe

# Batas waktu satu job render (milidetik, > 0)
NAZE_RENDER_TIMEOUT_MS=300000

# Batas waktu unduhan satu aset (milidetik, > 0)
NAZE_DOWNLOAD_TIMEOUT_MS=15000

# Batas ukuran body permintaan HTTP (byte, > 0)
NAZE_MAX_REQUEST_BODY_BYTES=16777216

# Batas ukuran satu aset unduhan (byte, > 0)
NAZE_MAX_ASSET_BYTES=5242880

# Jumlah render aktif bersamaan (1..8)
NAZE_MAX_ACTIVE_RENDERS=1

# Panjang antrean tunggu (1..100)
NAZE_MAX_QUEUED_RENDERS=20

# Asal CORS yang diizinkan, dipisah koma; format http(s)://host tanpa path
NAZE_ALLOWED_ORIGIN=

# Kunci API (minimal 16 karakter). WAJIB diisi di produksi.
NAZE_API_KEY=

# Hanya untuk pengembangan: 1 menonaktifkan autentikasi. Jangan dipakai di produksi.
NAZE_ALLOW_NO_AUTH=0
